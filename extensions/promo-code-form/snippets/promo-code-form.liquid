{%- liquid
  assign form_id = form_id | default: 'promo-code-form'
  assign api_base_url = api_base_url | strip
  if api_base_url == blank
    assign api_base_url = '/apps/lemonvision-promo'
  endif
  assign accent_color = accent_color | default: '#c9a227'
  assign discount_percentage = discount_percentage | default: 10
  if page_title == blank
    assign page_title = 'form.page_title' | t
  endif
  if page_subtitle == blank
    assign page_subtitle = 'form.page_subtitle' | t
  endif
  if offer_subheading == blank
    assign offer_subheading = 'form.offer_subheading' | t
  endif
  if community_banner == blank
    assign community_banner = 'form.community_banner' | t
  endif
  if eyebrow == blank
    assign eyebrow = 'Exclusive offer'
  endif
  assign show_page_header = show_page_header | default: true
  assign title_font_size = title_font_size | default: 40
  assign subtitle_font_size = subtitle_font_size | default: 17
  assign title_alignment = title_alignment | default: 'center'
-%}
<div class="promo-code-form-root">
<div
  class="promo-code-form"
  style="--promo-gold: {{ accent_color }}; --promo-gold-dark: {{ accent_color | color_darken: 12 }}; --promo-title-size: {{ title_font_size }}px; --promo-subtitle-size: {{ subtitle_font_size }}px;"
  data-promo-code-form
  data-api-endpoint="{{ api_base_url | escape }}"
  data-msg-success="{{ 'form.success_message' | t | replace: '"', '&quot;' }}"
  data-msg-duplicate="{{ 'form.duplicate_message' | t | replace: '"', '&quot;' }}"
  data-msg-error="{{ 'form.error_message' | t | replace: '"', '&quot;' }}"
  data-msg-invalid-email="{{ 'form.invalid_email_message' | t | replace: '"', '&quot;' }}"
  data-msg-missing-app-url="{{ 'form.missing_app_url_message' | t | replace: '"', '&quot;' }}"
  data-msg-copied="{{ 'form.copied_message' | t | replace: '"', '&quot;' }}"
  {{ shopify_attributes }}
>
  {%- if show_page_header -%}
    {%- if page_title != blank or page_subtitle != blank -%}
    <div class="promo-code-form__page-header promo-code-form__page-header--{{ title_alignment }}">
      {%- if page_title != blank -%}
        <h2 class="promo-code-form__page-title">{{ page_title }}</h2>
      {%- endif -%}
      {%- if page_subtitle != blank -%}
        <p class="promo-code-form__page-subtitle">{{ page_subtitle }}</p>
      {%- endif -%}
    </div>
    {%- endif -%}
  {%- endif -%}

  <div class="promo-code-form__ticket">
    <div class="promo-code-form__panel promo-code-form__panel--offer">
      <div class="promo-code-form__badge">
        <span class="promo-code-form__badge-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M20.6 12.8 12 18.5 3.4 12.8V6.2L12 2.5l8.6 3.7v6.6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <circle cx="12" cy="11" r="2.2" stroke="currentColor" stroke-width="1.7"/>
          </svg>
        </span>
        {{ eyebrow | upcase }}
      </div>

      <h3 class="promo-code-form__offer-title">
        Get
        <span
          class="promo-code-form__offer-highlight promo-code-form__discount-value is-loading"
          data-promo-discount-value
          data-promo-discount-fallback="{{ discount_percentage }}"
          aria-busy="true"
        >
          <span class="promo-code-form__discount-shimmer" aria-hidden="true"></span>
        </span>% OFF
      </h3>
      <p class="promo-code-form__offer-subtitle">{{ offer_subheading }}</p>

      <ul class="promo-code-form__features">
        <li class="promo-code-form__feature">
          <span class="promo-code-form__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 3.5 18.5 6.5V11.5C18.5 15.6 15.7 18.7 12 20C8.3 18.7 5.5 15.6 5.5 11.5V6.5L12 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M9.5 12.2 11.2 14 14.8 10.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>
            <strong>{{ 'form.feature_1_title' | t }}</strong>
            <small>{{ 'form.feature_1_desc' | t }}</small>
          </span>
        </li>
        <li class="promo-code-form__feature">
          <span class="promo-code-form__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.7"/>
              <path d="M12 8.2V12.2L14.6 14.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>
            <strong>{{ 'form.feature_2_title' | t }}</strong>
            <small>{{ 'form.feature_2_desc' | t }}</small>
          </span>
        </li>
        <li class="promo-code-form__feature">
          <span class="promo-code-form__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.7"/>
              <path d="M9.1 12.1 11.1 14.1 15.1 9.9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>
            <strong>{{ 'form.feature_3_title' | t }}</strong>
            <small>{{ 'form.feature_3_desc' | t }}</small>
          </span>
        </li>
      </ul>

      <div class="promo-code-form__community">
        <span aria-hidden="true">✨</span>
        {{ community_banner }}
      </div>
    </div>

    <div class="promo-code-form__panel promo-code-form__panel--action">
      <div class="promo-code-form__request" data-promo-request-panel>
        <p class="promo-code-form__code-label">{{ 'form.email_label' | t }}</p>

        <form class="promo-code-form__fields" data-promo-code-form-el novalidate>
          <label class="promo-code-form__sr-only" for="promo-email-{{ form_id }}">
            {{ 'form.email_label' | t }}
          </label>
          <input
            type="email"
            id="promo-email-{{ form_id }}"
            name="email"
            class="promo-code-form__input"
            placeholder="{{ 'form.email_placeholder' | t }}"
            required
            autocomplete="email"
          >

          <button type="submit" class="promo-code-form__submit">
            <span class="promo-code-form__submit-text">{{ 'form.submit_label' | t }}</span>
            <span class="promo-code-form__submit-spinner" aria-hidden="true"></span>
          </button>

          <p class="promo-code-form__status" data-promo-code-form-status role="status" aria-live="polite"></p>
          <p class="promo-code-form__footnote">{{ 'form.footnote' | t }}</p>
        </form>
      </div>

      <div class="promo-code-form__result" data-promo-result-panel hidden>
        <p class="promo-code-form__code-label">{{ 'form.code_label' | t | upcase }}</p>

        <div class="promo-code-form__code-box">
          <code class="promo-code-form__code-value" data-promo-code-value></code>
          <button type="button" class="promo-code-form__copy-icon" data-promo-copy-icon aria-label="Copy code">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/>
              <path d="M7 15H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.8"/>
            </svg>
          </button>
        </div>

        <button type="button" class="promo-code-form__submit promo-code-form__submit--copy" data-promo-copy-button>
          <span aria-hidden="true">🏷</span>
          {{ 'form.copy_code_label' | t | upcase }}
        </button>

        <p class="promo-code-form__result-message" data-promo-result-message></p>
        <p class="promo-code-form__expiry">{{ 'form.expiry_note' | t }}</p>
      </div>
    </div>
  </div>
</div>
</div>
